# Supabase — copy this file to ".env" and fill in your project's values.
# Find these in your Supabase dashboard under:
#   Project Settings → API → Project URL  and  Project API keys → anon public
#
# VITE_SUPABASE_URL: your project's API endpoint, e.g. https://<project-ref>.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY: the "anon" / "publishable" key (NOT the service_role secret)

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key-here
